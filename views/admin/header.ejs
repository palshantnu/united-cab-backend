          <script>
            // Highlight the current page in the sidebar and open its submenu
            document.addEventListener('DOMContentLoaded', function () {
              var here = location.pathname;
              document.querySelectorAll('#sidebar .sidebar-menu a[href^="/"]').forEach(function (a) {
                var target = a.getAttribute('href').split('?')[0];
                if (target === '/' || !(here === target || here.indexOf(target + '/') === 0)) return;
                var li = a.closest('li');
                li.classList.add('active', 'current-page');
                var sub = li.closest('.submenu');
                if (sub) {
                  sub.style.display = 'block';
                  sub.closest('li.has-submenu').classList.add('active');
                }
              });
            });
          </script>

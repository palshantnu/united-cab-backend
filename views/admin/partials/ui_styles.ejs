<style>
  .uc-card { border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); background: #fff; }
  .uc-card .card-header { background: transparent; border-bottom: 1px solid #f0f0f0; padding: 1.25rem 1.5rem; }
  .stat-tile { border: none; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); background: #fff; padding: 1.1rem 1.25rem; height: 100%; }
  .stat-tile .label { color: #6c757d; font-size: .78rem; text-transform: uppercase; letter-spacing: .4px; font-weight: 600; }
  .stat-tile .value { font-size: 1.55rem; font-weight: 700; color: #2c3e50; line-height: 1.2; margin-top: .25rem; }
  .stat-tile .hint { font-size: .78rem; color: #8a939c; }
  .stat-tile .icon { width: 42px; height: 42px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
  .custom-table thead th { background-color: #f8f9fa; color: #6c757d; font-weight: 700; font-size: .75rem; text-transform: uppercase; border: none; padding: 12px; white-space: nowrap; }
  .custom-table tbody td { padding: 12px; vertical-align: middle; border-color: #f3f4f6; }
  .status-badge { padding: 5px 11px; border-radius: 50px; font-weight: 600; font-size: .72rem; text-transform: uppercase; display: inline-block; }
  .badge-pending, .badge-searching, .badge-accepted, .badge-arrived, .badge-started, .badge-rideend { background: #fff3cd; color: #856404; }
  .badge-approved, .badge-completed, .badge-active { background: #d4edda; color: #155724; }
  .badge-rejected, .badge-cancelled { background: #f8d7da; color: #721c24; }
  .badge-expired { background: #e2e3e5; color: #41464b; }
  .amount-credit { color: #198754; font-weight: 700; }
  .amount-debit { color: #dc3545; font-weight: 700; }
  .amount-none { color: #6c757d; font-weight: 600; }
  .filter-bar .form-control, .filter-bar .form-select { min-width: 140px; }
  .dataTables_wrapper .dataTables_paginate .paginate_button.current { background: #0d6efd !important; color: #fff !important; border: none; border-radius: 4px; }
  .dataTables_filter input { border: 1px solid #dee2e6; border-radius: 20px; padding: 5px 15px; outline: none; }
</style>

<% if (typeof success !== 'undefined' && success && success.length) { %>
  <div class="alert alert-success alert-dismissible fade show mx-3 mt-3 mb-0" role="alert">
    <%= success.join(' ') %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length) { %>
  <div class="alert alert-danger alert-dismissible fade show mx-3 mt-3 mb-0" role="alert">
    <%= error.join(' ') %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

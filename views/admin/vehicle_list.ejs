<%- include('./header.ejs') %>

<style>
  /* Custom Professional Styling */
  .app-body { background-color: #f4f7f6; padding-top: 20px; }
  .card { border: none; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.05); }
  .card-header { background: #fff; border-bottom: 1px solid #eee; padding: 20px; border-radius: 12px 12px 0 0 !important; }
  .card-title { font-weight: 700; color: #333; margin: 0; }
  
  /* Table Styling */
  .custom-table thead { background-color: #f8f9fa; }
  .custom-table th { 
    text-transform: uppercase; 
    font-size: 0.75rem; 
    letter-spacing: 1px; 
    font-weight: 600; 
    color: #6c757d; 
    border-top: none;
  }
  .custom-table td { font-size: 0.9rem; padding: 15px; vertical-align: middle; }
  .table-hover tbody tr:hover { background-color: #f1f6ff; transition: 0.3s; }
  
  /* Badge & Elements */
  .badge-soft-success { background-color: #d1e7dd; color: #0f5132; border-radius: 50px; padding: 5px 12px; }
  .badge-soft-secondary { background-color: #e2e3e5; color: #41464b; border-radius: 50px; padding: 5px 12px; }
  .time-badge { background: #e7f1ff; color: #0d6efd; font-weight: 600; padding: 4px 8px; border-radius: 6px; font-size: 0.85rem; }
  .vehicle-name { font-weight: 600; color: #2c3e50; }
  .price-text { color: #198754; font-weight: 700; }
</style>

<div class="app-body">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card mb-3">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="card-title"><i class="bi bi-truck me-2"></i>Vehicle Management</h4>
            <button type="button" class="btn btn-primary btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#addVehicleType">
              <i class="bi bi-plus-lg me-1"></i> Add Vehicle Type
            </button>
          </div>
          
          <div class="card-body">
            <% if (success && success.length > 0) { %>
              <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-check-circle me-2"></i><%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>

            <% if (error && error.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i><%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
            <% } %>

            <div class="table-responsive">
              <table id="tripsTable" class="table table-hover align-middle custom-table m-0">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Vehicle Name</th>
                    <th>Label</th>
                    <th>Pricing Details</th>
                    <th>Commision</th>
                    <th>Shift & Hours</th>
                    <th>Holiday Fare</th>
                    <th class="text-center">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% vehicles.forEach((vehicle, index) => { %>
                    <tr>
                      <td><span class="text-muted"><%= index + 1 %></span></td>
                      <td><span class="vehicle-name"><%= vehicle.type_name %></span></td>
                      <td>
                      <% if (vehicle.label) { %>
                      <span class="badge bg-light text-dark border"><%= vehicle.label %></span>
                      <% } else { %>
                      <span class="text-muted small">—</span>
                      <% } %>
                      </td> 
                      <td>
                        <div class="small text-muted">Min Mile: <%= vehicle.minimum_km %> mi</div>
                        <div>Min Fare: <span class="price-text">£<%= vehicle.minimum_fare %></span></div>
                        <div class="small text-muted">Per Mile: £<%= vehicle.fare_per_km %></div>
                      </td>
                      <td><span class="badge bg-light text-dark border">£<%= vehicle.platform_fee %></span></td>
                      <td>
                        <div class="mb-1">
                          <span class="badge <%= vehicle.shift_type === 'Morning' ? 'bg-info' : 'bg-dark' %>"><%= vehicle.shift_type %></span>
                        </div>
                        <span class="time-badge">
                          <i class="bi bi-clock-history me-1"></i>
                          <%= new Date('1970-01-01T' + vehicle.start_time).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }) %> - 
                          <%= new Date('1970-01-01T' + vehicle.end_time).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true }) %>
                        </span>
                      </td>
                      <td>
                        <% if (vehicle.is_holiday) { %>
                          <span class="badge-soft-success small fw-bold">Active</span>
                        <% } else { %>
                          <span class="badge-soft-secondary small">Inactive</span>
                        <% } %>
                      </td>
                      <td class="text-center">
                        <div class="btn-group">
                          <a href="/vehicles/edit/<%= vehicle.id %>" class="btn btn-outline-primary btn-sm mx-1" title="Edit">
                            <i class="bi bi-pencil-square"></i>
                          </a>
                          <a href="/vehicles/delete/<%= vehicle.id %>" class="btn btn-outline-danger btn-sm mx-1" 
                             onclick="return confirm('Are you sure you want to delete this vehicle?')" title="Delete">
                            <i class="bi bi-trash3"></i>
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="addVehicleType" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add New Vehicle Type</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <form id="vehicleTypeForm" action="/vehicle/store" method="POST" enctype="multipart/form-data">
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Vehicle Name</label>
                <input type="text" class="form-control" name="type_name" placeholder="e.g. Luxury Sedan" required>
              </div>
              <div class="col-md-6">
              <label class="form-label fw-bold">Label</label>
              <input type="text" class="form-control" name="label" placeholder="e.g. Premium">
              </div>
              <div class="col-md-6">
              <label class="form-label fw-bold">Capacity (passengers)</label>
              <input type="number" class="form-control" name="capacity" placeholder="4" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Minimum Mile</label>
                <input type="number" step="0.01" class="form-control" name="minimum_km" placeholder="2" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Minimum Fare (£)</label>
                <input type="number" step="0.01" class="form-control" name="minimum_fare" placeholder="50.00" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Fare Per Mile (£)</label>
                <input type="number" step="0.01" class="form-control" name="fare_per_km" placeholder="10.00" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Commission Fee (£)</label>
                <input type="number" step="0.01" class="form-control" name="platform_fee" placeholder="5.00" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Shift Type</label>
                <select class="form-select" name="shift_type" required>
                  <option value="">Select Shift</option>
                  <option value="Morning">Morning</option>
                  <option value="Night">Night</option>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">Start Time</label>
                <input type="time" class="form-control" name="start_time" required>
              </div>
              <div class="col-md-6">
                <label class="form-label fw-bold">End Time</label>
                <input type="time" class="form-control" name="end_time" required>
              </div>
              <div class="col-md-12 mt-3">
                <div class="form-check form-switch">
                  <input class="form-check-input" type="checkbox" id="isHoliday" name="is_holiday" value="1">
                  <label class="form-check-label fw-bold" for="isHoliday">Apply Holiday Charges</label>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" form="vehicleTypeForm" class="btn btn-primary px-4">Save Vehicle</button>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('./footer.ejs') %>
<%- include('./header.ejs') %>

<div class="app-body">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card mb-3 border-0 shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <h5 class="card-title mb-0 fw-bold text-dark">
                                    <i class="bi bi-shield-check text-primary me-2"></i>Trips History
                                </h5>
                            </div>
                            <div class="col-md-8">
                                <div class="d-flex flex-wrap justify-content-md-end gap-2 mt-2 mt-md-0">
                                    <div class="input-group input-group-sm" style="width: 200px;">
                                        <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                                        <input type="text" id="tableSearch" class="form-control border-0 bg-light shadow-none" placeholder="Search customer...">
                                    </div>

                                    <select id="bookingTypeFilter" class="form-select form-select-sm border-0 bg-light shadow-none fw-bold" style="width: 130px;">
                                        <option value="all">All Types</option>
                                        <option value="Instant">Instant</option>
                                        <option value="Scheduled">Schedule</option>
                                    </select>

                                    <select id="statusFilter" class="form-select form-select-sm border-0 bg-light shadow-none fw-bold text-primary" style="width: 130px;">
                                        <option value="all">All Status</option>
                                        <option value="completed">Completed</option>
                                        <option value="pending">Pending</option>
                                        <option value="cancelled">Cancelled</option>
                                    </select>

                                    <button id="bulkDeleteBtn" class="btn btn-sm btn-danger d-none" onclick="bulkDeleteSelected()">
                                        <i class="bi bi-trash3 me-1"></i><span id="bulkDeleteCount">0</span> Delete Selected
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="tripsTable" class="table table-hover align-middle custom-table mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 30px;">
                                            <input type="checkbox" id="selectAllCheckbox" class="form-check-input">
                                        </th>
                                        <th>#</th>
                                        <th>Trip Schedule</th>
                                        <th>Customer</th>
                                        <th>Driver / Vehicle</th>
                                        <th>Route Details</th>
                                        <th>Trip Info</th>
                                        <th>Fare</th>
                                        <th>Status</th>
                                        <th>Booked At</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% bookings.forEach((ride, index) => { %>
                                    <tr class="ride-row"
                                        data-id="<%= ride.id %>"
                                        data-type="<%= ride.booking_type || 'Instant' %>"
                                        data-status="<%= ride.status %>"
                                        data-customer="<%= ride.User?.name || '' %>">

                                       <td>
                                           <input type="checkbox" class="form-check-input row-checkbox" value="<%= ride.id %>">
                                       </td>
                                       <td><small class="text-muted fw-bold"><%= index + 1 %></small></td>
                                       <td>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-dark mb-1" style="font-size: 0.85rem;">
                                                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                                                    <span class="utc-to-ist" data-time="<%= ride.scheduled_at %>">
                                                        <% if (ride.scheduled_at) { %>
                                                            <%= new Date(ride.scheduled_at).toLocaleDateString() %> 
                                                            <%= new Date(ride.scheduled_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                                        <% } else { %>
                                                            N/A
                                                        <% } %>
                                                    </span>
                                                </span>
                                                <span class="badge bg-light text-dark border mt-1 w-fit shadow-sm" style="font-size: 0.7rem;">
                                                    <i class="bi bi-lightning-fill text-warning me-1"></i><%= ride.booking_type || 'Instant' %>
                                                </span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-info me-2 rounded-circle bg-soft-primary text-primary">
                                                    <%= (ride.User?.name || 'G').charAt(0).toUpperCase() %>
                                                </div>
                                                <span class="fw-semibold text-dark"><%= ride.User?.name || 'Guest' %></span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark"><%= ride.Driver?.name || 'Not Assigned' %></div>
                                            <div class="badge bg-soft-secondary text-muted" style="font-size: 0.7rem;">
                                                <i class="bi bi-car-front me-1"></i><%= ride.Driver?.vehicle_number || 'N/A' %>
                                            </div>
                                        </td>
                                        <td style="max-width: 250px;">
                                            <div class="address-container">
                                                <div class="text-truncate small mb-1" title="<%= ride.pickup_address %>">
                                                    <i class="bi bi-circle-fill text-success me-2" style="font-size: 7px;"></i><%= ride.pickup_address %>
                                                </div>
                                                <div class="text-truncate small text-muted" title="<%= ride.dropoff_address %>">
                                                    <i class="bi bi-geo-alt-fill text-danger me-2" style="font-size: 9px;"></i><%= ride.dropoff_address %>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="small"><i class="bi bi-stopwatch text-muted me-1"></i><%= ride.duration_min %> Mins</div>
                                            <div class="small text-muted fw-medium text-capitalize"><%= ride.VehicleType?.name || 'Standard' %></div>
                                        </td>

                                        <td>
                                            <div class="fw-bold text-dark">£<%= ride.final_fare || '0.00' %></div>
                                        </td>

                                        <td>
                                            <% 
                                                let badgeClass = 'bg-soft-secondary text-secondary';
                                                if(ride.status === 'completed') badgeClass = 'bg-soft-success text-success';
                                                if(ride.status === 'cancelled') badgeClass = 'bg-soft-danger text-danger';
                                                if(ride.status === 'pending') badgeClass = 'bg-soft-warning text-warning';
                                            %>
                                            <span class="badge <%= badgeClass %> border-0 text-capitalize py-2 px-3 fw-bold shadow-xs">
                                                ● <%= ride.status %>
                                            </span>
                                        </td>
                                        <td>
                                        <div class="small text-muted">
                                            <i class="bi bi-clock-history me-1"></i>
                                            <span class="utc-to-ist" data-time="<%= ride.created_at %>"></span>
                                        </div>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a href="/bookings-details/<%= ride.id %>" class="btn btn-icon btn-light btn-sm rounded-circle border shadow-sm">
                                                    <i class="bi bi-eye text-primary"></i>
                                                </a>
                                                <% if (['pending', 'accepted', 'arrived'].includes(ride.status)) { %>
                                                 <a href="/bookings/cancel/<%= ride.id %>" class="btn btn-outline-warning btn-sm" onclick="return confirm('Are you sure you want to cancel this booking?')" data-bs-toggle="tooltip" title="Cancel Booking">
                                                 <i class="bi bi-x-circle"></i>
                                                </a>
                                                <% } %>
                                                <button onclick="confirmDelete('<%= ride.id %>')" class="btn btn-icon btn-light btn-sm rounded-circle border shadow-sm">
                                                    <i class="bi bi-trash3 text-danger"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .w-fit { width: fit-content; }
    .bg-soft-primary { background-color: #eef2ff; color: #4338ca; }
    .bg-soft-success { background-color: #ecfdf5; color: #059669; }
    .bg-soft-danger { background-color: #fef2f2; color: #dc2626; }
    .bg-soft-warning { background-color: #fffbeb; color: #d97706; }
    .bg-soft-secondary { background-color: #f9fafb; color: #6b7280; }

    .avatar-info {
        width: 30px; height: 30px; display: flex;
        align-items: center; justify-content: center;
        font-weight: bold; font-size: 12px;
    }

    .custom-table thead th {
        font-size: 0.75rem; text-transform: uppercase;
        letter-spacing: 0.5px; padding: 15px; border: none;
    }

    .ride-row:hover { background-color: #f8fbff !important; transition: 0.2s; }
    .btn-icon { width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; }
    
    /* Shadow for status badges */
    .shadow-xs { box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const searchInput = document.getElementById('tableSearch');
    const typeFilter = document.getElementById('bookingTypeFilter');
    const statusFilter = document.getElementById('statusFilter');
    const rows = document.querySelectorAll('.ride-row');

    function filterTable() {
        const searchText = searchInput.value.toLowerCase();
        const typeValue = typeFilter.value.toLowerCase();
        const statusValue = statusFilter.value.toLowerCase();

        rows.forEach(row => {
            const customerName = row.getAttribute('data-customer').toLowerCase();
            const rideType = row.getAttribute('data-type').toLowerCase();
            const rideStatus = row.getAttribute('data-status').toLowerCase();

            const matchesSearch = customerName.includes(searchText);
            const matchesType = (typeValue === 'all' || rideType === typeValue);
            const matchesStatus = (statusValue === 'all' || rideStatus === statusValue);

            if (matchesSearch && matchesType && matchesStatus) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
        renumberRows();
    }

    // Event Listeners
    searchInput.addEventListener('input', filterTable);
    typeFilter.addEventListener('change', filterTable);
    statusFilter.addEventListener('change', filterTable);

    // ============ MULTIPLE DELETE ============
    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
    const bulkDeleteBtn = document.getElementById('bulkDeleteBtn');
    const bulkDeleteCount = document.getElementById('bulkDeleteCount');

    function getRowCheckboxes() {
        return document.querySelectorAll('.row-checkbox');
    }
    function getSelectedIds() {
        return Array.from(getRowCheckboxes())
            .filter(cb => cb.checked && cb.closest('tr').style.display !== 'none')
            .map(cb => cb.value);
    }
    function refreshBulkUI() {
        const selected = getSelectedIds();
        if (selected.length > 0) {
            bulkDeleteBtn.classList.remove('d-none');
            bulkDeleteCount.textContent = selected.length;
        } else {
            bulkDeleteBtn.classList.add('d-none');
        }
        const visible = Array.from(getRowCheckboxes()).filter(cb => cb.closest('tr').style.display !== 'none');
        selectAllCheckbox.checked = visible.length > 0 && visible.every(cb => cb.checked);
    }

    selectAllCheckbox.addEventListener('change', (e) => {
        getRowCheckboxes().forEach(cb => {
            if (cb.closest('tr').style.display !== 'none') cb.checked = e.target.checked;
        });
        refreshBulkUI();
    });
    getRowCheckboxes().forEach(cb => cb.addEventListener('change', refreshBulkUI));

    function bulkDeleteSelected() {
        const ids = getSelectedIds();
        if (ids.length === 0) return;

        Swal.fire({
            title: `Delete ${ids.length} trip(s)?`,
            text: "These trips will be permanently deleted!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete all!',
            cancelButtonText: 'Cancel',
            reverseButtons: true
        }).then((result) => {
            if (!result.isConfirmed) return;
            Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            fetch('/bookings/delete-multiple', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    removeRowsByIds(ids);
                    Swal.fire({
                        title: 'Deleted!', text: data.message, icon: 'success', timer: 1500, showConfirmButton: false
                    });
                } else {
                    Swal.fire('Error', data.message || 'Failed to delete', 'error');
                }
            })
            .catch(err => Swal.fire('Error', err.message, 'error'));
        });
    }

    function removeRowsByIds(ids) {
        const idSet = new Set(ids.map(String));
        document.querySelectorAll('.ride-row').forEach(tr => {
            if (idSet.has(tr.dataset.id)) tr.remove();
        });
        renumberRows();
        refreshBulkUI();
        showEmptyStateIfNeeded();
    }
    function renumberRows() {
        let n = 1;
        document.querySelectorAll('.ride-row').forEach(tr => {
            if (tr.style.display === 'none') return; // hidden rows skip
            const numCell = tr.querySelector('td:nth-child(2) small');
            if (numCell) numCell.textContent = n++;
        });
    }
    function showEmptyStateIfNeeded() {
        const tbody = document.querySelector('#tripsTable tbody');
        if (!tbody.querySelector('.ride-row')) {
            const colCount = document.querySelectorAll('#tripsTable thead th').length;
            tbody.innerHTML = `<tr><td colspan="${colCount}" class="text-center text-muted py-4">No trips found</td></tr>`;
        }
    }

    function confirmDelete(id) {
        Swal.fire({
            title: 'Are you sure?',
            text: "This trip will be permanently deleted!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel',
            reverseButtons: true
        }).then((result) => {
            if (!result.isConfirmed) return;
            Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
            fetch('/bookings/delete-multiple', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: [id] })
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    removeRowsByIds([id]);
                    Swal.fire({ title: 'Deleted!', icon: 'success', timer: 1200, showConfirmButton: false });
                } else {
                    Swal.fire('Error', data.message || 'Failed to delete', 'error');
                }
            })
            .catch(err => Swal.fire('Error', err.message, 'error'));
        });
    }
    // Add this inside your existing <script> tag
document.addEventListener("DOMContentLoaded", function() {
    const timeElements = document.querySelectorAll('.utc-to-ist');
    
    timeElements.forEach(el => {
        const rawTime = el.getAttribute('data-time');
        if (rawTime && rawTime !== 'null' && rawTime !== 'undefined') {
            const date = new Date(rawTime);
            
            // Check if date is valid
            if (!isNaN(date.getTime())) {
                const formattedDate = date.toLocaleDateString();
                const formattedTime = date.toLocaleTimeString([], { 
                    hour: '2-digit', 
                    minute: '2-digit',
                    hour12: true 
                });
                el.innerText = `${formattedDate} ${formattedTime}`;
            }
        } else {
            el.innerText = "No Schedule";
        }
    });
});
</script>

<%- include('./footer.ejs') %>
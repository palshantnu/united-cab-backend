<%- include('./header.ejs') %>
<%- include('./partials/ui_styles.ejs') %>
<%
  const gbp = n => '£' + (parseFloat(n) || 0).toFixed(2);
  const rate = Ridecount > 0 ? ((completeTrips / Ridecount) * 100).toFixed(1) : 0;
  const statusMap = {
    completed: ['bg-success-subtle text-success', 'check-circle-fill'],
    cancelled: ['bg-danger-subtle text-danger', 'x-circle-fill'],
    pending:   ['bg-warning-subtle text-warning', 'clock-fill'],
    accepted:  ['bg-info-subtle text-info', 'person-check-fill'],
    started:   ['bg-primary-subtle text-primary', 'play-circle-fill'],
    arrived:   ['bg-secondary-subtle text-secondary', 'pin-map-fill'],
    searching: ['bg-warning-subtle text-warning', 'search'],
    rideend:   ['bg-success-subtle text-success', 'flag-fill']
  };
%>
<style>
  .dash-tile { border: none; border-radius: 1rem; box-shadow: 0 4px 20px rgba(0,0,0,0.05); background: #fff; height: 100%; }
  .dash-tile .ic { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; }
  .dash-tile h3 { font-weight: 700; margin: 0; }
  .mini-stat { display: flex; align-items: center; gap: .75rem; padding: .9rem 1rem; border-radius: .75rem; background: #f8f9fb; height: 100%; text-decoration: none; color: inherit; }
  .mini-stat:hover { background: #eef2f7; }
  .mini-stat .num { font-weight: 700; font-size: 1.15rem; line-height: 1.1; }
  .mini-stat .lbl { font-size: .75rem; color: #6c757d; }
  .alert-link-card { border-left: 4px solid #ffc107; }
</style>

<div class="app-body">
  <div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <div>
        <h4 class="fw-bold mb-0">Dashboard Overview</h4>
        <p class="text-muted small mb-0">Here's what's happening with United Cabs today.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/reports/revenue" class="btn btn-sm btn-outline-primary"><i class="bi bi-graph-up me-1"></i>Revenue</a>
        <a href="/push-notifications" class="btn btn-sm btn-primary"><i class="bi bi-send me-1"></i>Send Notification</a>
      </div>
    </div>

    <!-- Needs attention -->
    <% if (pending.payouts || pending.recharges) { %>
      <div class="card border-0 shadow-sm rounded-4 mb-4 alert-link-card">
        <div class="card-body py-3 d-flex flex-wrap align-items-center gap-3">
          <span class="fw-semibold"><i class="bi bi-bell-fill text-warning me-2"></i>Needs your attention</span>
          <% if (pending.payouts) { %>
            <a href="/payout-requests?status=pending" class="btn btn-sm btn-warning"><%= pending.payouts %> payout request(s)</a>
          <% } %>
          <% if (pending.recharges) { %>
            <a href="/driver-recharge-history" class="btn btn-sm btn-outline-warning"><%= pending.recharges %> recharge request(s)</a>
          <% } %>
        </div>
      </div>
    <% } %>

    <!-- Today / this month -->
    <div class="row g-3 mb-4">
      <div class="col-xl-3 col-sm-6">
        <div class="dash-tile p-4">
          <div class="d-flex justify-content-between mb-3">
            <div class="ic" style="background:#e8f4fd;color:#1a73e8;"><i class="bi bi-car-front-fill"></i></div>
            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 align-self-start">Today</span>
          </div>
          <h3><%= today.rides %></h3>
          <p class="text-muted mb-0 small">Rides today • <%= today.completed %> completed</p>
        </div>
      </div>
      <div class="col-xl-3 col-sm-6">
        <div class="dash-tile p-4">
          <div class="d-flex justify-content-between mb-3">
            <div class="ic" style="background:#e6f9f0;color:#1db954;"><i class="bi bi-cash-coin"></i></div>
            <span class="badge bg-success-subtle text-success rounded-pill px-3 align-self-start">Today</span>
          </div>
          <h3><%= gbp(today.gross) %></h3>
          <p class="text-muted mb-0 small">Fares collected today</p>
        </div>
      </div>
      <div class="col-xl-3 col-sm-6">
        <a href="/earnings/admin" class="text-decoration-none text-reset">
          <div class="dash-tile p-4">
            <div class="d-flex justify-content-between mb-3">
              <div class="ic" style="background:#fff8e1;color:#f9a825;"><i class="bi bi-currency-pound"></i></div>
              <span class="badge bg-warning-subtle text-warning rounded-pill px-3 align-self-start"><%= month.name %></span>
            </div>
            <h3><%= gbp(month.platform) %></h3>
            <p class="text-muted mb-0 small">Platform earnings (subs <%= gbp(month.subscriptions) %> + rides <%= gbp(month.rideCharges) %>)</p>
          </div>
        </a>
      </div>
      <div class="col-xl-3 col-sm-6">
        <div class="dash-tile p-4">
          <div class="d-flex justify-content-between mb-3">
            <div class="ic" style="background:#f3e5f5;color:#8e24aa;"><i class="bi bi-activity"></i></div>
            <span class="badge rounded-pill px-3 align-self-start" style="background:#e8f5e9;color:#2e7d32;">
              <i class="bi bi-circle-fill me-1" style="font-size:7px;"></i>Live
            </span>
          </div>
          <h3><%= liveRides %></h3>
          <p class="text-muted mb-0 small">Rides in progress • <%= onTripDrivers %> driver(s) on trip</p>
        </div>
      </div>
    </div>

    <!-- Totals -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
      <div class="card-body p-3">
        <div class="row g-2">
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/bookings" class="mini-stat"><i class="bi bi-list-check fs-4 text-primary"></i><div><div class="num"><%= Ridecount %></div><div class="lbl">Total rides</div></div></a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/bookings?status=completed" class="mini-stat"><i class="bi bi-check-circle fs-4 text-success"></i><div><div class="num"><%= completeTrips %></div><div class="lbl">Completed (<%= rate %>%)</div></div></a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/bookings?status=cancelled" class="mini-stat"><i class="bi bi-x-circle fs-4 text-danger"></i><div><div class="num"><%= cancelTrips %></div><div class="lbl">Cancelled</div></div></a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/drivers" class="mini-stat"><i class="bi bi-person-badge fs-4" style="color:#8e24aa;"></i><div><div class="num"><%= driverCount %></div><div class="lbl"><%= onlineDrivers %> online now</div></div></a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/users" class="mini-stat"><i class="bi bi-people fs-4 text-info"></i><div><div class="num"><%= userCount %></div><div class="lbl">Users (+<%= today.newUsers %> today)</div></div></a>
          </div>
          <div class="col-6 col-md-4 col-xl-2">
            <a href="/admin/driver-subscription-history" class="mini-stat"><i class="bi bi-card-checklist fs-4 text-warning"></i><div><div class="num"><%= activeSubs %></div><div class="lbl">Active subscriptions</div></div></a>
          </div>
        </div>
      </div>
    </div>

    <!-- Charts -->
    <div class="row g-3 mb-4">
      <div class="col-xl-8">
        <div class="card border-0 shadow-sm rounded-4 h-100">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h6 class="fw-bold mb-0">Rides – Last 14 Days</h6>
                <small class="text-muted">Daily ride volume and fares</small>
              </div>
              <a href="/reports/trips" class="btn btn-sm btn-outline-primary rounded-3">Trip Reports</a>
            </div>
            <div id="ridesChart" style="min-height: 300px;"></div>
          </div>
        </div>
      </div>
      <div class="col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
          <div class="card-body p-4">
            <h6 class="fw-bold mb-0">Trip Status</h6>
            <small class="text-muted">All time</small>
            <div id="statusDonut" class="mt-2"></div>
            <div class="mt-3">
              <div class="d-flex justify-content-between mb-2 small"><span><span class="rounded-circle d-inline-block me-2" style="width:10px;height:10px;background:#1db954;"></span>Completed</span><span class="fw-bold"><%= completeTrips %></span></div>
              <div class="d-flex justify-content-between mb-2 small"><span><span class="rounded-circle d-inline-block me-2" style="width:10px;height:10px;background:#e53935;"></span>Cancelled</span><span class="fw-bold"><%= cancelTrips %></span></div>
              <div class="d-flex justify-content-between small"><span><span class="rounded-circle d-inline-block me-2" style="width:10px;height:10px;background:#1a73e8;"></span>In progress / other</span><span class="fw-bold"><%= Ridecount - completeTrips - cancelTrips %></span></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Drivers -->
    <div class="row g-3 mb-4">
      <div class="col-xl-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h6 class="fw-bold mb-0">Top Drivers – <%= month.name %></h6>
                <small class="text-muted">By completed ride fares</small>
              </div>
              <a href="/reports/drivers" class="btn btn-sm btn-outline-primary rounded-3">Performance</a>
            </div>
            <% if (topDrivers.length) { %>
              <% topDrivers.forEach((d, i) => { %>
                <a href="/driver/<%= d.id %>" class="d-flex align-items-center justify-content-between py-2 border-bottom text-decoration-none text-reset">
                  <div class="d-flex align-items-center gap-3">
                    <span class="fw-bold text-muted" style="width: 20px;"><%= i + 1 %></span>
                    <div>
                      <div class="fw-semibold small"><%= d.name %></div>
                      <div class="text-muted" style="font-size: 12px;"><%= d.rides %> ride(s)</div>
                    </div>
                  </div>
                  <span class="fw-bold"><%= gbp(d.earnings) %></span>
                </a>
              <% }) %>
            <% } else { %>
              <p class="text-muted small mb-0">No completed rides this month yet.</p>
            <% } %>
          </div>
        </div>
      </div>
      <div class="col-xl-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
          <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h6 class="fw-bold mb-0">New Drivers</h6>
                <small class="text-muted">Latest registrations</small>
              </div>
              <a href="/drivers" class="btn btn-sm btn-outline-primary rounded-3">All Drivers</a>
            </div>
            <% if (newDrivers.length) { %>
              <% newDrivers.forEach(d => { %>
                <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                  <div>
                    <a href="/driver/<%= d.id %>" class="fw-semibold small text-decoration-none"><%= d.name || 'Driver #' + d.id %></a>
                    <div class="text-muted" style="font-size: 12px;">
                      <%= d.VehicleType?.type_name || 'No vehicle' %> •
                      <span class="moment-time" data-time="<%= d.created_at ? new Date(d.created_at).toISOString() : '' %>"></span>
                    </div>
                  </div>
                  <div class="d-flex align-items-center gap-2">
                    <span class="badge <%= d.status != 0 ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' %>"><%= d.status != 0 ? 'Active' : 'Inactive' %></span>
                    <a href="/driver/edit/<%= d.id %>" class="btn btn-sm btn-light" title="Edit"><i class="bi bi-pencil"></i></a>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <p class="text-muted small mb-0">No drivers yet.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- Recent trips -->
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h6 class="fw-bold mb-0">Recent Trips</h6>
            <small class="text-muted">Latest ride requests</small>
          </div>
          <a href="/bookings" class="btn btn-sm btn-outline-primary rounded-3">View All Trips</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
              <tr>
                <th class="ps-3 py-3 small fw-bold text-secondary text-uppercase">Trip</th>
                <th class="py-3 small fw-bold text-secondary text-uppercase">Passenger</th>
                <th class="py-3 small fw-bold text-secondary text-uppercase">Driver</th>
                <th class="py-3 small fw-bold text-secondary text-uppercase">Route</th>
                <th class="py-3 small fw-bold text-secondary text-uppercase">Fare</th>
                <th class="py-3 small fw-bold text-secondary text-uppercase">Status</th>
                <th class="py-3 small fw-bold text-secondary text-uppercase">Time</th>
              </tr>
            </thead>
            <tbody>
              <% recentRides.forEach(ride => { const [badgeClass, icon] = statusMap[ride.status] || ['bg-secondary-subtle text-secondary', 'circle']; %>
                <tr>
                  <td class="ps-3"><a href="/bookings-details/<%= ride.id %>" class="fw-bold text-decoration-none">#<%= ride.id %></a></td>
                  <td>
                    <div class="fw-semibold text-dark small"><%= ride.user ? ride.user.name : 'N/A' %></div>
                    <div class="text-muted" style="font-size:12px;"><%= ride.user ? ride.user.phone : '' %></div>
                  </td>
                  <td>
                    <% if (ride.driver) { %>
                      <a href="/driver/<%= ride.driver.id %>" class="fw-semibold small text-decoration-none"><%= ride.driver.name %></a>
                      <div class="text-muted" style="font-size:12px;"><%= ride.driver.phone %></div>
                    <% } else { %>
                      <span class="text-muted small">Unassigned</span>
                    <% } %>
                  </td>
                  <td>
                    <div class="text-truncate small text-muted" style="max-width:220px;" title="<%= ride.pickup_address %>"><i class="bi bi-geo-alt-fill text-success me-1"></i><%= ride.pickup_address || '-' %></div>
                    <div class="text-truncate small text-muted" style="max-width:220px;" title="<%= ride.dropoff_address %>"><i class="bi bi-geo-alt-fill text-danger me-1"></i><%= ride.dropoff_address || '-' %></div>
                  </td>
                  <td>
                    <span class="fw-bold small">
                      <% if (ride.final_fare) { %><%= gbp(ride.final_fare) %><% } else if (ride.fare_estimate) { %>~<%= gbp(ride.fare_estimate) %><% } else { %>-<% } %>
                    </span>
                  </td>
                  <td>
                    <span class="badge <%= badgeClass %> rounded-pill px-2 py-1 small">
                      <i class="bi bi-<%= icon %> me-1" style="font-size:10px;"></i><%= ride.status %>
                    </span>
                  </td>
                  <td><span class="text-muted small moment-time" data-time="<%= new Date(ride.created_at).toISOString() %>"></span></td>
                </tr>
              <% }) %>
              <% if (recentRides.length === 0) { %>
                <tr><td colspan="7" class="text-center text-muted py-4">No rides found</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>

<%- include('./footer.ejs') %>
<script>
  (function () {
    const chart = <%- JSON.stringify(chart) %>;
    new ApexCharts(document.querySelector('#ridesChart'), {
      chart: { type: 'bar', height: 300, stacked: true, toolbar: { show: false }, fontFamily: 'inherit' },
      series: [
        { name: 'Completed', type: 'column', data: chart.completed },
        { name: 'Cancelled', type: 'column', data: chart.cancelled },
        { name: 'Other', type: 'column', data: chart.other },
        { name: 'Fares (£)', type: 'line', data: chart.gross }
      ],
      colors: ['#1db954', '#e53935', '#1a73e8', '#f9a825'],
      stroke: { width: [0, 0, 0, 3], curve: 'smooth' },
      xaxis: { categories: chart.labels, labels: { style: { fontSize: '11px' } } },
      yaxis: [
        { seriesName: 'Completed', title: { text: 'Rides' }, min: 0, forceNiceScale: true, labels: { formatter: v => Math.round(v) } },
        { seriesName: 'Completed', show: false },
        { seriesName: 'Completed', show: false },
        { seriesName: 'Fares (£)', opposite: true, title: { text: 'Fares' }, labels: { formatter: v => '£' + Math.round(v) } }
      ],
      plotOptions: { bar: { borderRadius: 4, columnWidth: '50%' } },
      dataLabels: { enabled: false },
      grid: { borderColor: '#f0f0f0', strokeDashArray: 4 },
      legend: { position: 'top' },
      tooltip: { shared: true, intersect: false }
    }).render();

    const total = <%= Ridecount %>;
    new ApexCharts(document.querySelector('#statusDonut'), {
      chart: { type: 'donut', height: 220, fontFamily: 'inherit' },
      series: total ? [<%= completeTrips %>, <%= cancelTrips %>, <%= Ridecount - completeTrips - cancelTrips %>] : [1],
      labels: total ? ['Completed', 'Cancelled', 'Other'] : ['No rides'],
      colors: total ? ['#1db954', '#e53935', '#1a73e8'] : ['#e9ecef'],
      legend: { show: false },
      dataLabels: { enabled: false },
      plotOptions: { pie: { donut: { size: '70%', labels: { show: true, total: { show: true, label: 'Total', formatter: () => String(total) } } } } },
      stroke: { width: 0 }
    }).render();
  })();
</script>

<%- include('./header.ejs') %>
<%- include('./partials/ui_styles.ejs') %>
<%
  const statusText = driver.status == 2 ? 'On Trip' : driver.status == 1 ? 'Active' : 'Inactive';
  const statusCls = driver.status == 2 ? 'bg-primary' : driver.status == 1 ? 'bg-success' : 'bg-danger';
  const txLabel = { wallet: 'Ride Charge', subscription: 'Subscription Miles', payout: 'Payout', fare: 'Fare', bonus: 'Admin Credit', penalty: 'Admin Debit' };
  const vt = driver.VehicleType;
  const fmtTime = t => t ? new Date('1970-01-01T' + t).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) : '-';
%>

<div class="app-body mt-4">
  <div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <div>
        <a href="/drivers" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Drivers</a>
        <h4 class="fw-bold m-0">Driver #<%= driver.id %></h4>
      </div>
      <div class="d-flex gap-2">
        <a href="/driver/edit/<%= driver.id %>" class="btn btn-warning"><i class="bi bi-pencil me-1"></i>Edit Driver</a>
        <a href="/driver/status/<%= driver.id %>" class="btn <%= driver.status != 0 ? 'btn-outline-danger' : 'btn-outline-success' %>"
           onclick="return confirm('<%= driver.status != 0 ? 'Deactivate' : 'Activate' %> this driver?')">
          <i class="bi bi-power me-1"></i><%= driver.status != 0 ? 'Deactivate' : 'Activate' %>
        </a>
      </div>
    </div>

    <div class="row g-4">
      <!-- Left: profile -->
      <div class="col-12 col-xl-4">
        <div class="card uc-card mb-4">
          <div class="card-body text-center p-4">
            <% if (photoUrl) { %>
              <img src="<%= photoUrl %>" alt="" class="rounded-circle mb-3" style="width: 110px; height: 110px; object-fit: cover;">
            <% } else { %>
              <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3" style="width: 110px; height: 110px;">
                <i class="bi bi-person fs-1 text-primary"></i>
              </div>
            <% } %>
            <h5 class="fw-bold mb-1"><%= driver.name || '-' %></h5>
            <div class="text-muted mb-2"><%= driver.country_code || '' %> <%= driver.phone || '' %></div>
            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <span class="badge <%= statusCls %>"><%= statusText %></span>
              <span class="badge <%= driver.online_status ? 'bg-success' : 'bg-secondary' %>"><%= driver.online_status ? 'Online' : 'Offline' %></span>
              <span class="badge <%= driver.phone_varified ? 'bg-info' : 'bg-warning text-dark' %>"><%= driver.phone_varified ? 'Phone verified' : 'Phone not verified' %></span>
            </div>
          </div>
          <ul class="list-group list-group-flush">
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Gender</span><span><%= driver.gender || '-' %></span></li>
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted">License No.</span><span><%= driver.license_number || '-' %></span></li>
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Vehicle Type</span><span><%= vt ? vt.type_name : '-' %></span></li>
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Vehicle No.</span><span class="fw-semibold"><%= driver.vehicle_number || '-' %></span></li>
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Vehicle Model</span><span><%= driver.vehicle_model || '-' %></span></li>
            <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Joined</span><span><%= driver.created_at ? new Date(driver.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '-' %></span></li>
            <% if (driver.driver_latitude && driver.driver_longitude) { %>
              <li class="list-group-item d-flex justify-content-between">
                <span class="text-muted">Last Location</span>
                <a target="_blank" rel="noopener" href="https://www.google.com/maps?q=<%= driver.driver_latitude %>,<%= driver.driver_longitude %>">Open map <i class="bi bi-box-arrow-up-right"></i></a>
              </li>
            <% } %>
          </ul>
        </div>

        <!-- Wallet -->
        <div class="card uc-card mb-4">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="text-muted small text-uppercase fw-semibold">Wallet Balance</div>
                <div class="fs-3 fw-bold">£<%= (parseFloat(driver.wallet) || 0).toFixed(2) %></div>
                <% if (pendingPayouts) { %>
                  <a href="/payout-requests?status=pending" class="small text-warning"><%= pendingPayouts %> pending payout request(s)</a>
                <% } %>
              </div>
              <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#walletModal">
                <i class="bi bi-plus-slash-minus me-1"></i>Adjust
              </button>
            </div>
            <hr>
            <div class="text-muted small text-uppercase fw-semibold mb-1">Subscription</div>
            <% if (activeSubscription) { %>
              <div class="fw-semibold"><%= activeSubscription.subscription?.name || 'Plan' %></div>
              <div class="small text-muted">
                <%= activeSubscription.mile %> miles left • valid till <%= activeSubscription.end_date %>
              </div>
            <% } else { %>
              <div class="small text-muted">No active subscription</div>
            <% } %>
            <a href="/transaction-history?driver_id=<%= driver.id %>" class="small d-inline-block mt-2">All transactions →</a>
          </div>
        </div>

        <!-- Vehicle type info -->
        <% if (vt) { %>
          <div class="card uc-card">
            <div class="card-header"><h6 class="m-0 fw-bold">Vehicle Type: <%= vt.type_name %></h6></div>
            <ul class="list-group list-group-flush small">
              <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Minimum Fare</span><span>£<%= vt.minimum_fare || 0 %></span></li>
              <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Fare per Mile</span><span>£<%= vt.fare_per_km || 0 %></span></li>
              <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Commission Fee</span><span><%= vt.platform_fee || 0 %></span></li>
              <li class="list-group-item d-flex justify-content-between"><span class="text-muted">Shift</span><span><%= vt.shift_type || '-' %> (<%= fmtTime(vt.start_time) %> – <%= fmtTime(vt.end_time) %>)</span></li>
            </ul>
          </div>
        <% } %>
      </div>

      <!-- Right: performance -->
      <div class="col-12 col-xl-8">
        <div class="row g-3 mb-4">
          <div class="col-6 col-md-3"><div class="stat-tile"><div class="label">Total Rides</div><div class="value"><%= stats.total %></div></div></div>
          <div class="col-6 col-md-3"><div class="stat-tile"><div class="label">Completed</div><div class="value text-success"><%= stats.completed %></div><div class="hint"><%= stats.completionRate %>% completion</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-tile"><div class="label">Earnings</div><div class="value">£<%= stats.earnings.toFixed(2) %></div><div class="hint"><%= stats.distance.toFixed(1) %> distance</div></div></div>
          <div class="col-6 col-md-3"><div class="stat-tile"><div class="label">Rating</div><div class="value"><% if (stats.rating) { %><i class="bi bi-star-fill text-warning fs-5"></i> <%= stats.rating %><% } else { %>—<% } %></div><div class="hint"><%= stats.ratingCount %> review(s)</div></div></div>
        </div>

        <div class="card uc-card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="m-0 fw-bold">Recent Trips</h6>
            <a href="/reports/trips" class="small">Trip reports →</a>
          </div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table align-middle custom-table m-0">
                <thead><tr><th>ID</th><th>Date</th><th>Passenger</th><th>Route</th><th>Fare</th><th>Status</th></tr></thead>
                <tbody>
                  <% recentRides.forEach(r => { %>
                    <tr>
                      <td><a href="/bookings-details/<%= r.id %>" class="fw-bold text-decoration-none">#<%= r.id %></a></td>
                      <td><span class="utc-to-ist small" data-time="<%= new Date(r.created_at).toISOString() %>"></span></td>
                      <td><%= r.user?.name || '-' %></td>
                      <td class="small" style="max-width: 240px;">
                        <div class="text-truncate"><i class="bi bi-geo-alt text-success"></i> <%= r.pickup_address || '-' %></div>
                        <div class="text-truncate"><i class="bi bi-geo-alt-fill text-danger"></i> <%= r.dropoff_address || '-' %></div>
                      </td>
                      <td class="fw-bold">£<%= (parseFloat(r.final_fare || r.fare_estimate) || 0).toFixed(2) %></td>
                      <td><span class="status-badge badge-<%= r.status %>"><%= r.status %></span></td>
                    </tr>
                  <% }) %>
                  <% if (!recentRides.length) { %><tr><td colspan="6" class="text-center text-muted py-4">No trips yet</td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="card uc-card mb-4">
          <div class="card-header"><h6 class="m-0 fw-bold">Recent Wallet Transactions</h6></div>
          <div class="card-body">
            <div class="table-responsive">
              <table class="table align-middle custom-table m-0">
                <thead><tr><th>Date</th><th>Type</th><th>Description</th><th class="text-end">Amount</th></tr></thead>
                <tbody>
                  <% transactions.forEach(t => { const credit = t.type === 'bonus'; const none = t.type === 'subscription'; %>
                    <tr>
                      <td><span class="utc-to-ist small" data-time="<%= new Date(t.created_at).toISOString() %>"></span></td>
                      <td><%= txLabel[t.type] || t.type %></td>
                      <td class="small text-muted"><%= t.description || '' %></td>
                      <td class="text-end <%= none ? 'amount-none' : credit ? 'amount-credit' : 'amount-debit' %>">
                        <% if (none) { %><%= t.distance %> mi<% } else { %><%= credit ? '+' : '−' %>£<%= (parseFloat(t.amount) || 0).toFixed(2) %><% } %>
                      </td>
                    </tr>
                  <% }) %>
                  <% if (!transactions.length) { %><tr><td colspan="4" class="text-center text-muted py-4">No transactions yet</td></tr><% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="card uc-card">
          <div class="card-header"><h6 class="m-0 fw-bold">Documents</h6></div>
          <div class="card-body">
            <% if (driver.DriverDocuments && driver.DriverDocuments.length) { %>
              <div class="row g-3">
                <% driver.DriverDocuments.forEach(doc => { const url = docUrl(doc.document_file); %>
                  <div class="col-12 col-md-6">
                    <div class="border rounded-3 p-3 h-100">
                      <div class="d-flex justify-content-between align-items-start">
                        <div>
                          <div class="fw-semibold text-capitalize"><i class="bi bi-file-earmark-text me-1"></i><%= doc.document_type || 'Document' %></div>
                          <div class="small text-muted">Vehicle: <%= doc.vehicle_number || '-' %></div>
                          <div class="small text-muted">Uploaded: <%= doc.uploaded_at ? new Date(doc.uploaded_at).toLocaleDateString('en-GB') : '-' %></div>
                        </div>
                        <span class="badge <%= doc.verified ? 'bg-success' : 'bg-warning text-dark' %>"><%= doc.verified ? 'Verified' : 'Not verified' %></span>
                      </div>
                      <div class="d-flex gap-2 mt-3">
                        <% if (url) { %><a href="<%= url %>" target="_blank" class="btn btn-sm btn-light"><i class="bi bi-eye me-1"></i>View</a><% } %>
                        <form method="POST" action="/driver/document/<%= doc.id %>/verify">
                          <button class="btn btn-sm <%= doc.verified ? 'btn-outline-danger' : 'btn-outline-success' %>">
                            <%= doc.verified ? 'Mark unverified' : 'Mark verified' %>
                          </button>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <p class="text-muted m-0">No documents uploaded.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Wallet adjustment -->
<div class="modal fade" id="walletModal" tabindex="-1">
  <div class="modal-dialog">
    <form method="POST" action="/driver/<%= driver.id %>/wallet-adjust" class="modal-content"
          onsubmit="return confirm('Apply this wallet adjustment?')">
      <div class="modal-header">
        <h5 class="modal-title">Adjust Wallet</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="btn-group w-100 mb-3">
          <input type="radio" class="btn-check" name="direction" id="dirCredit" value="credit" checked>
          <label class="btn btn-outline-success" for="dirCredit"><i class="bi bi-plus-circle me-1"></i>Credit</label>
          <input type="radio" class="btn-check" name="direction" id="dirDebit" value="debit">
          <label class="btn btn-outline-danger" for="dirDebit"><i class="bi bi-dash-circle me-1"></i>Debit</label>
        </div>
        <label class="form-label">Amount (£)</label>
        <input type="number" name="amount" class="form-control mb-3" min="0.01" step="0.01" required>
        <label class="form-label">Reason</label>
        <input type="text" name="reason" class="form-control" maxlength="200" required placeholder="e.g. Refund for cancelled trip #123">
        <div class="form-text">The driver gets an in-app notification with this reason.</div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Apply</button>
      </div>
    </form>
  </div>
</div>

<%- include('./footer.ejs') %>

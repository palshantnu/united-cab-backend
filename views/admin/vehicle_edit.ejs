<%- include('./header.ejs') %>

    <div class="app-body">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h4 class="card-title">Vehicle Type Edit</h4>
                        </div>
                        <div class="card-body">

                            <form action="/vehicles/update/<%= vehicle.id %>" method="POST"
                                enctype="multipart/form-data">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="vehicleName" class="form-label">Vehicle Name</label>
                                        <input type="text" class="form-control" id="vehicleName" name="type_name"
                                            value="<%= vehicle.type_name %>"  >
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                    <label for="label" class="form-label">Label</label>
                                    <input type="text" class="form-control" id="label" name="label"
                                            value="<%= vehicle.label || '' %>">
                                    </div>

                                    <div class="col-md-6 mb-3">
                                      <label for="capacity" class="form-label">Capacity (passengers)</label>
                                      <input type="number" class="form-control" id="capacity" name="capacity" value="<%= vehicle.capacity %>" required>
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="minimumKm" class="form-label">Minimum mile</label>
                                        <input type="number" step="0.01" class="form-control" id="minimumKm"
                                            name="minimum_km" value="<%= vehicle.minimum_km %>"  >
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="minimumFare" class="form-label">Minimum mile Fare (£)</label>
                                        <input type="number" step="0.01" class="form-control" id="minimumFare"
                                            name="minimum_fare" value="<%= vehicle.minimum_fare %>"  >
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="farePerKm" class="form-label">Fare Per mile (£)</label>
                                        <input type="number" step="0.01" class="form-control" id="farePerKm"
                                            name="fare_per_km" value="<%= vehicle.fare_per_km %>"  >
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="platformFee" class="form-label">Commision Fee (£)</label>
                                        <input type="number" step="0.01" class="form-control" id="platformFee"
                                            name="platform_fee" value="<%= vehicle.platform_fee %>"  >
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label for="vehicleImage" class="form-label">Vehicle Image</label>
                                        <input type="file" class="form-control" id="vehicleImage" name="vehicle_image"
                                            accept="image/*">
                                        <% if (vehicle.vehicle_image) { %>
                                            <img src="/uploads/<%= vehicle.vehicle_image %>" alt="Current Image"
                                                height="80" class="mt-2">
                                            <% } %>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="vehicleLogo" class="form-label">Vehicle Logo</label>
                                        <input type="file" class="form-control" id="vehicleLogo" name="vehicle_logo"
                                            accept="image/*">
                                        <% if (vehicle.vehicle_logo) { %>
                                            <img src="/uploads/<%= vehicle.vehicle_logo %>" alt="Current Logo"
                                                height="80" class="mt-2">
                                            <% } %>
                                    </div>
                                <div class="col-md-6 mb-3">
                                  <label for="shiftType" class="form-label">Shift Type</label>
                                   <select class="form-select" id="shiftType" name="shift_type" required>
                                    <option value="">Select Shift</option>
                                    <option value="Morning" <%= vehicle.shift_type === 'Morning' ? 'selected' : '' %>>Morning</option>
                                    <option value="Night" <%= vehicle.shift_type === 'Night' ? 'selected' : '' %>>Night</option>
                                   </select>
                                </div>
                                  <!-- Start Time -->
                                  <div class="col-md-6 mb-3">
                                    <label for="startTime" class="form-label">Start Time</label>
                                    <input type="time" class="form-control" id="startTime" name="start_time" value="<%= vehicle.start_time %>" >
                                  </div>

                                  <!-- End Time -->
                                  <div class="col-md-6 mb-3">
                                    <label for="endTime" class="form-label">End Time</label>
                                    <input type="time" class="form-control" id="endTime" name="end_time" value="<%= vehicle.end_time %>" >
                                  </div>
                                  <div class="col-12 mb-3">
                                        <label for="description" class="form-label">Description</label>
                                        <textarea class="form-control" id="description" name="description" rows="3"
                                            placeholder="Optional description..."><%= vehicle.description || '' %></textarea>
                                   </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="isHoliday" class="form-label">Is Holiday Fare?</label>
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="isHoliday" name="is_holiday" value="1" <%= vehicle.is_holiday ? 'checked' : '' %>>
                                            <label class="form-check-label" for="isHoliday">Yes (Holiday charges)</label>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary">Update Vehicle</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <%- include('./footer.ejs') %>
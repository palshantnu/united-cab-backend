<script>
$(document).ready(function() {
    function convertTimes() {
        $('.utc-to-ist').each(function() {
            const rawTime = $(this).data('time');
            if (rawTime) {
                // Step 1: Parse as UTC
                // Step 2: Convert to Local (IST)
                // Step 3: Format it
                const istTime = moment.utc(rawTime).local().format('DD MMM YYYY, hh:mm A');
                $(this).text(istTime);
            }
        });

        $('.moment-time').each(function() {
            const rawTime = $(this).data('time');
            if (rawTime) {
                // "2 hours ago" wala logic bhi UTC se Local karke
                $(this).html('<i class="bi bi-clock-history me-1"></i>' + moment.utc(rawTime).local().fromNow());
            }
        });
    }

    convertTimes();
    // Live update for "fromNow"
    setInterval(convertTimes, 60000);
});
</script>


<%- include('./header.ejs') %>

<style>
  /* Modern Dashboard Card */
  .request-card {
    border: none;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    background: #fff;
  }

  .card-header {
    background: transparent;
    border-bottom: 1px solid #f0f0f0;
    padding: 1.5rem;
  }

  /* Status Badge Styling */
  .badge-pending { background-color: #fff3cd; color: #856404; border: 1px solid #ffeeba; }
  .badge-approved { background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; }
  .badge-rejected { background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; }
  
  .status-badge {
    padding: 6px 12px;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  /* Table Customization */
  .custom-table thead th {
    background-color: #f8f9fa;
    color: #6c757d;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    border: none;
    padding: 15px;
  }

  .custom-table tbody td {
    padding: 15px;
    vertical-align: middle;
    border-color: #f8f9fa;
  }

  /* Action Buttons */
  .btn-approve {
    background-color: #28a745;
    border: none;
    transition: 0.3s;
  }
  .btn-approve:hover { background-color: #218838; transform: translateY(-1px); }

  .btn-reject {
    background-color: #dc3545;
    border: none;
    transition: 0.3s;
  }
  .btn-reject:hover { background-color: #c82333; transform: translateY(-1px); }

  .amount-text {
    font-weight: 700;
    color: #2c3e50;
    font-size: 1rem;
  }

  .driver-info {
    font-weight: 600;
    color: #007bff;
  }
</style>

<div class="app-body mt-4">
  <div class="container-fluid">
    <div class="row">
      <div class="col-12">
        <div class="card request-card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <div>
              <h4 class="card-title m-0 fw-bold">Wallet Recharge Requests</h4>
              <small class="text-muted">Review and manage driver balance top-ups</small>
            </div>
            <span class="badge bg-primary rounded-pill"><%= drivers.length %> Total Requests</span>
          </div>
          
          <div class="card-body">
            <div class="table-responsive">
              <table id="tripsTable" class="table align-middle custom-table m-0">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Driver Details</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Date & Time</th>
                    <th class="text-center">Manage Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% drivers.forEach((entry, index) => { %>
                    <tr>
                      <td class="text-muted fw-bold">#<%= index + 1 %></td>
                      <td>
                        <div class="d-flex align-items-center">
                          <div class="avatar-sm me-3 bg-soft-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; background: #e7f1ff;">
                            <i class="bi bi-person text-primary"></i>
                          </div>
                          <span class="driver-info"><%= entry.driver?.name || 'Unknown Driver' %></span>
                        </div>
                      </td>
                      <td>
                        <span class="amount-text">€<%= entry.amount %></span>
                      </td>
                      <td>
                        <% 
                          let statusClass = 'badge-pending';
                          if(entry.status === 'approved') statusClass = 'badge-approved';
                          if(entry.status === 'rejected') statusClass = 'badge-rejected';
                        %>
                        <span class="status-badge <%= statusClass %>">
                          <%= entry.status %>
                        </span>
                      </td>
                      <td>
                        <div class="small text-dark"><%= entry.requested_at.toLocaleDateString() %></div>
                        <div class="text-muted small" style="font-size: 0.7rem;"><%= entry.requested_at.toLocaleTimeString() %></div>
                      </td>
                      <td class="text-center">
                        <% if (entry.status === 'pending') { %>
                          <div class="d-flex justify-content-center gap-2">
                            <form method="POST" action="/recharge-request/update-status/<%= entry.id %>">
                              <input type="hidden" name="status" value="approved" />
                              <button type="submit" class="btn btn-success btn-sm px-3 rounded-pill shadow-sm btn-approve">
                                <i class="bi bi-check2-circle me-1"></i> Approve
                              </button>
                            </form>
                            <form method="POST" action="/recharge-request/update-status/<%= entry.id %>">
                              <input type="hidden" name="status" value="rejected" />
                              <button type="submit" class="btn btn-danger btn-sm px-3 rounded-pill shadow-sm btn-reject">
                                <i class="bi bi-x-circle me-1"></i> Reject
                              </button>
                            </form>
                          </div>
                        <% } else { %>
                          <span class="text-muted small italic">Processed</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('./footer.ejs') %>